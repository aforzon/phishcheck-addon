# PhishCheck Configuration
# Copy this file to .env and fill in your values

# Flask
SECRET_KEY=your-secure-secret-key-here
DEBUG=False

# Database
DATABASE_PATH=phishcheck.db

# Microsoft Graph API (Azure AD App Registration)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
PHISHING_MAILBOX=phishing@forzon.ca

# CISO Alerts
CISO_EMAIL=ciso@forzon.ca
ENABLE_CISO_ALERTS=True

# Analysis Thresholds
THRESHOLD_PHISHING=70
THRESHOLD_SUSPICIOUS=40

# Demo credentials (change in production!)
DEMO_USERNAME=admin
DEMO_PASSWORD=phishcheck2024
